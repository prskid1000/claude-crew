{
  "guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "view_file|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "kit-health": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 600
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
        "timeout": 120
      }
    ]
  }
}
