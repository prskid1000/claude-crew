{
  "guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/skills/crafty/crafty.ps1 guard",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "kit-health": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/skills/bossy/bossy.ps1 health",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File .claude/skills/bossy/bossy.ps1 cleanup -IfDue -Quiet",
        "timeout": 600
      }
    ]
  }
}
