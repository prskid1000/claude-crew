# Workflow scripts must be LF (CR is rejected as a control character)
*.js text eol=lf
*.mjs text eol=lf
# git hooks run under sh: LF only
.githooks/* text eol=lf
# crew tool allowlists: commits keep the manifest line, the installed kit gets its kit.local.json grants (kitbag.py tools --filter)
agents/*.md filter=kittools
