# This repo IS a workspace's .claude folder (git clone ... <workspace>/.claude). Everything below stays local.
# Org-only paths not covered here go in skills/dev-kit/kit.local.json "localOnly": kit.ps1 setup writes them into
# .git/info/exclude (kit.ps1 health runs it at SessionStart), so they never show in git status.

# runtime (disposable: work/ cache/ logs/) and durable local state (tracking, learning, deploy log, tracker-none, local env secrets)
/.runtime/
/.state/
# the old layout (kit.ps1 setup -Migrate moves it)
/.claude-runtime/

# local config, org rules and lessons (kit.ps1 setup -WriteLocal writes the config files from kit.example.json)
*.local.*
*.local/
settings.local.json
skills/android-swarm/swarm.config.json
skills/android-swarm/swarm.json
rules/*.local.md

# harness state Claude Code writes into .claude (auto memory: kit.ps1 setup points autoMemoryDirectory at /memory)
/memory/
/agent-memory-local/
/scheduled_tasks.lock
/worktrees/

# installs, caches, build output
node_modules/
package-lock.json
__pycache__/
*.apk
*.log
