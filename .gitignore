# This repo IS a workspace's .claude folder (git clone ... <workspace>/.claude). Everything below stays local.
# Org-only paths that are not covered here go in skills/dev-kit/kit.local.json "localOnly": kit-exclude.ps1 writes them
# into .git/info/exclude (kit-health runs it at SessionStart), so they never show in git status.

# runtime: disposable (work/ cache/ logs/), rebuilt by the scripts; see docs/runtime.md
/.claude-runtime/

# local config, org rules and durable local state (copy the *.example.json files)
*.local.*
*.local/
settings.local.json
skills/dev-kit/kit.local.json
skills/qa-kit/targets.local.json
skills/android-swarm/swarm.config.json
skills/android-swarm/swarm.json
skills/android-swarm/apk/
rules/*.local.md

# harness state Claude Code writes into .claude (auto memory: kit-setup points autoMemoryDirectory at /memory)
/memory/
/agent-memory-local/
/scheduled_tasks.lock
/worktrees/

# installs, caches, build output
node_modules/
__pycache__/
*.apk
*.log
