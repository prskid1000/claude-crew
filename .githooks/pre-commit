#!/bin/sh
# Kit pre-commit gate (enabled by orch.ps1 setup): regenerates the README graph sections (kittool.py flow --readme), runs lint.
# Ports (kittool.py port, extra ports: skipped without it) are regenerated and deployed to the workspace root (.codex, .agents, GEMINI.md) on every pre-commit.
# Pre-commit blocks only on: flow --readme failure, or kittool.py lint problems (unreached files, budgets: trim first,
# then kittool.py budget raise, file cap, conventions). Logic: skills/orchestrate/orch.ps1 precommit (extra kit-admin). Exit 1 = blocked.
root="$(git rev-parse --show-toplevel)"
# its logic is the extra kit-admin (orch.ps1 prepush / precommit): installed here first when missing (a fresh clone, a new worktree)
if [ ! -f "$root/skills/orchestrate/adapters/kit_admin.ps1" ]; then
  for p in python python3 py; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c '' >/dev/null 2>&1; then "$p" -X utf8 "$root/skills/orchestrate/kittool.py" extra add kit-admin </dev/null >&2; break; fi
  done
fi
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$root/skills/orchestrate/orch.ps1" precommit
fi
echo "pre-commit: pwsh 7 is not installed, so the kit's graph / lint checks cannot run. Install pwsh, then commit again." >&2
exit 1
