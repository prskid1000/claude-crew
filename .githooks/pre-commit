#!/bin/sh
# Kit pre-commit gate (enabled by bossy.ps1 setup): regenerates the README graph sections (kitbag.py flow --readme), runs lint.
# Ports (kitbag.py port, goody ports: skipped without it) are regenerated and deployed to the workspace root (.codex, .agents, GEMINI.md) on every pre-commit.
# Pre-commit blocks only on: flow --readme failure, or kitbag.py lint problems (unreached files, budgets: trim first,
# then kitbag.py budget raise, file cap, conventions). Logic: skills/bossy/bossy.ps1 precommit (goody kit-admin). Exit 1 = blocked.
root="$(git rev-parse --show-toplevel)"
# its logic is the goody kit-admin (bossy.ps1 prepush / precommit): installed here first when missing (a fresh clone, a new worktree)
if [ ! -f "$root/skills/bossy/adapters/kit_admin.ps1" ]; then
  for p in python python3 py; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c '' >/dev/null 2>&1; then "$p" -X utf8 "$root/skills/bossy/kitbag.py" goody add kit-admin </dev/null >&2; break; fi
  done
fi
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$root/skills/bossy/bossy.ps1" precommit
fi
echo "pre-commit: pwsh 7 is not installed, so the kit's graph / lint checks cannot run. Install pwsh, then commit again." >&2
exit 1
