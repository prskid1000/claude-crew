#!/bin/sh
# Kit pre-push gate (enabled by kit.ps1 setup: git config core.hooksPath .githooks): blocks a push that carries an org term or a
# git-ignored / local-only file, or stale generated ports (kittool.py port --check). Logic: skills/orchestrate/kit.ps1 prepush (pwsh 7 + python). Exit 1 = blocked.
root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$root/skills/orchestrate/kit.ps1" prepush "$@"
fi
echo "pre-push: pwsh 7 is not installed, so the kit's org-term / local-file checks cannot run. Install pwsh, then push again." >&2
exit 1
