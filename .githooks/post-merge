#!/bin/sh
# Kit post-merge hook (enabled by bossy.ps1 setup: core.hooksPath .githooks; post-rewrite runs it after pull --rebase): after git
# pull / merge runs the one-time layout migration (kitbag.py migrate: old install records out; quick, idempotent), then in the
# background redeploys the workspace-root ports (kitbag.py port --deploy: ports.targets) and regenerates the kit-flow page
# (kitbag.py flow). Never opens it, never fails the merge.
root="$(git rev-parse --show-toplevel)"
for p in python python3 py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c '' >/dev/null 2>&1; then   # a store stub is on PATH but does not run
    "$p" -X utf8 "$root/skills/bossy/kitbag.py" migrate >&2 </dev/null
    (("$p" -X utf8 "$root/skills/bossy/kitbag.py" port --deploy; "$p" -X utf8 "$root/skills/bossy/kitbag.py" flow) >/dev/null 2>&1 &)
    break
  fi
done
exit 0
