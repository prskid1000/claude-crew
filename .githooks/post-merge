#!/bin/sh
# Kit post-merge hook (enabled by kit.ps1 setup: core.hooksPath .githooks): after git pull / merge, regenerates the live clone's
# kit-flow page (kittool.py flow). Never opens it, never fails the merge.
root="$(git rev-parse --show-toplevel)"
for p in python python3 py; do
  command -v "$p" >/dev/null 2>&1 && "$p" -X utf8 "$root/skills/orchestrate/kittool.py" flow >/dev/null 2>&1 && break
done
exit 0
