{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/.claude/.runtime/**)",
      "PowerShell(& *.claude\\skills\\*)",
      "PowerShell(& '*.claude\\skills\\*)",
      "PowerShell(python *.claude\\skills\\*)",
      "PowerShell(& *.claude/skills/*)",
      "PowerShell(& '*.claude/skills/*)",
      "PowerShell(python *.claude/skills/*)",
      "PowerShell(python3 *.claude/skills/*)",
      "PowerShell(pwsh *.claude/tests/*)",
      "Bash(pwsh *.claude/skills/*)",
      "Bash(python3 *.claude/skills/*)",
      "PowerShell(node *)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)",
      "PowerShell(git fetch*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git -C *)",
      "PowerShell(glab mr *)",
      "PowerShell(glab api *)",
      "PowerShell(glab auth status*)",
      "PowerShell(gh pr *)",
      "PowerShell(gh auth status*)",
      "PowerShell(gws drive files export *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git -C *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(find *)"
    ],
    "deny": [
      "Bash(git stash*)",
      "PowerShell(git stash*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/skills/orchestrate/orch.ps1", "health"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/skills/orchestrate/orch.ps1", "cleanup", "-IfDue", "-Quiet"],
            "timeout": 600,
            "async": true
          },
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/skills/orchestrate/orch.ps1", "health", "-Flow", "-Fetch"],
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/skills/dev-kit/dev.ps1", "guard"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/skills/orchestrate/orch.ps1", "guard-sendmessage"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
