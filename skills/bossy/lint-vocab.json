{
 "_readme": "kitbag.py lint ARCH-* vocabulary (kit-admin.md lint codes). families: words matched case-insensitive as whole words; default = ARCH-DEFAULT, enum = ARCH-ENUM (3+ distinct quoted values of one family in one file), lesson = ARCH-LESSON. vendorApi / platform / osTemp (ARCH-TEMP; python tempfile.* also outside a file that imports kitbag): regexes on comment-stripped code lines. A line with `arch-ok: <reason>` or inside legacy-defaults:start / :end markers is skipped.",
 "families": {
  "vendors": {"default": true, "lesson": true, "words": ["gitlab", "github", "bitbucket", "gitea", "jira", "clickup", "youtrack", "azure devops", "confluence", "notion", "gdocs", "new relic", "newrelic", "nrql", "sentry", "datadog", "jenkins", "aws", "gws", "glab", "slack", "whatsapp"]},
  "stacks": {"default": true, "lesson": true, "words": ["spring", "springframework", "elasticsearch", "liquibase", "flyway", "hibernate", "jhipster", "maven", "gradle", "angular", "react-native", "mysql", "mysqldump", "postgres", "systemd", "systemctl", "elastic beanstalk"]},
  "statuses": {"default": true, "enum": true, "words": ["in test", "promoted", "failedTesting", "failed testing", "for review", "in review", "inTest"]},
  "production": {"default": true, "words": ["prod", "production", "critical"]},
  "platforms": {"default": true, "words": ["android", "ios", "kmp"]},
  "markers": {"default": true, "words": ["[Unit Test]", "Unit Test", "CU-", "GH-", "GL-", "admin", "tenant_id", "access_token"]},
  "lanes": {"enum": true, "words": ["web", "api", "app"]},
  "deployKinds": {"enum": true, "words": ["branch", "awsStack", "ssh", "manual", "laneApk"]},
  "trackerTypes": {"enum": true, "words": ["clickup", "jira", "linear", "youtrack", "azure", "github", "gitlab"]},
  "hostTypes": {"enum": true, "words": ["gitlab", "github", "bitbucket", "gitea", "azure"]}
 },
 "vendorApi": [
  "(?:^|[;|({=&]\\s*|\\bthen\\s+|^\\s*)&?\\s*['\"]?(?:glab|gh)['\"]?\\s+(?:api|mr|pr|ci|run|repo|issue|auth|release)\\b",
  "/api/v4/",
  "/repos/[{$<]",
  "\\bprojects/[{$<:][^ ]*merge_requests",
  "/rest/api/\\d",
  "\\bsystemctl\\s+(?:restart|start|stop|is-active|show|status)\\b",
  "(?:^|[;|(&]\\s*|\\s&\\s*|^\\s*)['\"]?(?:mysql|mysqldump)['\"]?\\s+-",
  "(?:^|[;|(&]\\s*|^\\s*)['\"]?liquibase['\"]?\\s+(?:update|rollback|status|--)",
  "\\bschtasks(?:\\.exe)?\\s+/"
 ],
 "platform": {
  "calls": ["\\bschtasks\\b", "\\bGet-CimInstance\\b", "\\bGet-WmiObject\\b", "\\bGet-WinEvent\\b", "\\bwmic\\b", "\\breg(?:\\.exe)?\\s+(?:query|add|delete)\\b", "\\btaskkill\\b", "\\bmklink\\b", "\\bcmd(?:\\.exe)?['\"]?\\s+/[cdsk]", "-WindowStyle\\s+\\w", "['\"][\\w.-]+\\.(?:cmd|bat)['\"]", "\\bos\\.startfile\\(", "\\bwinreg\\b", "\\bctypes\\.windll\\b", "CREATE_NO_WINDOW"],
  "guard": "\\$KitIsWindows|\\$KitIsMac|\\$IsWindows|\\$IsLinux|\\$IsMacOS|Win32NT|\\bos\\.name\\b|\\bsys\\.platform\\b|\\bplatform\\.system\\(|\\bprocess\\.platform\\b"
 },
 "osTemp": ["\\[(?:System\\.)?IO\\.Path\\]::GetTemp(?:Path|FileName)\\(", "\\bNew-TemporaryFile\\b", "\\$env:(?:TEMP|TMP|TMPDIR)\\b", "GetEnvironmentVariable\\(\\s*['\"](?:TEMP|TMP|TMPDIR)['\"]",
  "\\btmpdir\\(\\)", "process\\.env\\.(?:TEMP|TMP|TMPDIR)\\b", "(?:environ(?:\\.get\\(|\\[)|getenv\\()\\s*['\"](?:TEMP|TMP|TMPDIR)['\"]", "(?<![\\w.~/:-])/tmp\\b"],
 "sbLog": {"_why": "ARCH-SBLOG: pwsh 7's script-block logging signatures (CompiledScriptBlock s_signatures, any case, substring); a skills/ .ps1 holding one is written whole to the event log on every load, as is pwsh text a skills/ .py hands to -Command / -EncodedCommand. cdxml: cmdlets whose cdxml module pwsh logs (~14 blocks) in each process that imports it. exempt: flagged.ps1 is run only when its call is needed; phoney loads native interop on phone verbs only.",
  "exempt": ["skills/crafty/flagged.ps1", "skills/phoney/swarm-ios.ps1", "skills/phoney/adapters/arrange.ps1"],
  "cdxml": "\\b(?:Get|Set|New|Remove|Test|Find)-Net(?:TCP|UDP|IP|Route|Neighbor|Adapter|Connection|Firewall)\\w*",
  "words": ["Add-Type", "DllImport", "DefineDynamicAssembly", "DefineDynamicModule", "DefineType", "DefineConstructor", "CreateType", "DefineLiteral", "DefineEnum", "DefineField", "ILGenerator", "Emit", "UnverifiableCodeAttribute", "DefinePInvokeMethod", "GetTypes", "GetAssemblies", "Methods", "Properties", "GetConstructor", "GetDefaultMembers", "GetEvent", "GetField", "GetInterface", "GetMember", "GetMethod", "GetNestedType", "GetProperty", "InvokeMember", "MakeArrayType", "MakeByRefType", "MakeGenericType", "MakePointerType", "DeclaringMethod", "DeclaringType", "ReflectedType", "TypeHandle", "TypeInitializer", "UnderlyingSystemType", "InteropServices", "Marshal", "AllocHGlobal", "PtrToStructure", "StructureToPtr", "FreeHGlobal", "IntPtr", "MemoryStream", "DeflateStream", "EncodedCommand", "Bypass", "ExpandString", "GetPowerShell", "OpenProcess", "VirtualAlloc", "VirtualFree", "WriteProcessMemory", "CreateUserThread", "CloseHandle", "GetDelegateForFunctionPointer", "CreateThread", "memcpy", "LoadLibrary", "GetModuleHandle", "GetProcAddress", "VirtualProtect", "FreeLibrary", "ReadProcessMemory", "CreateRemoteThread", "AdjustTokenPrivileges", "WriteByte", "OpenThreadToken", "PtrToString", "ZeroFreeGlobalAllocUnicode", "GetTokenInformation", "SetThreadToken", "ImpersonateLoggedOnUser", "RevertToSelf", "GetLogonSessionData", "CreateProcessWithToken", "DuplicateTokenEx", "OpenWindowStation", "OpenDesktop", "MiniDumpWriteDump", "AddSecurityPackage", "EnumerateSecurityPackages", "GetProcessHandle", "DangerousGetHandle", "CryptoServiceProvider", "Cryptography", "RijndaelManaged", "CryptoStream", "CreateEncryptor", "CreateDecryptor", "TransformFinalBlock", "DeviceIoControl", "SetInformationProcess", "PasswordDeriveBytes", "GetAsyncKeyState", "GetKeyboardState", "GetForegroundWindow", "BindingFlags", "NonPublic", "ScriptBlockLogging", "LogPipelineExecutionDetails", "ProtectedEventLogging"]}
