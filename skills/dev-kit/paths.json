{
  "_readme": "The ONE map of the kit's local state. Scripts never build these paths by hand: PowerShell Get-KitPath (lib.ps1), Python kit_path (devtools.py / kittool.py), Node kitPath (spec.mjs / browser.mjs) and each workflow's rp() helper resolve names from here (kit-lint RUNTIME-RAW / RUNTIME-MAP enforce it). 'runtime' entries live under <runtime> = $CLAUDE_RUNTIME, else <kit>/.runtime: disposable (work/ = in-flight runs, cache/ = rebuilt on demand, logs/ = append-only). 'durable' entries live under <kit>/.state/ (git-ignored): knowledge and task state that must survive a runtime wipe. Folders end in '/'. kit.ps1 setup -Migrate moves the old layout (.claude-runtime, *.local.* state at the kit root) here.",
  "runtimeDir": ".runtime",
  "stateDir": ".state",
  "legacy": {
    "runtimeDir": ".claude-runtime",
    "durable": {
      "signals": "learning.local.jsonl",
      "last-retro": "learning.local.stamp",
      "last-kit-audit": "kit-audit.local.stamp",
      "tracking": "tracking.local.json",
      "tracker-none": "tracker-none.local/",
      "localenv-env": "localenv.local/"
    }
  },
  "runtime": {
    "work": "work/",
    "cache": "cache/",
    "logs": "logs/",
    "waves": "work/waves/",
