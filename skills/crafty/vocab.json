{
 "_readme": "Built-in vocabulary lib.ps1 and devtools.py both read (one source): status roles (statuses: default names per role; statusOther: names that are no role), tracker vendor ids and links, the default testing docs, words a .ps1 must not hold (pwsh would log the script: tscNoOutput), deployed-env change commands (guard, testing-doc prose: envChangeCommands), e2e test runners (testRunners: detect by deps / files, cmd with {specs}, wholeSuiteRx the gate refuses, specGlobs, run output kept out of commits; kit.local.json tests.runners replaces the list), mrWord: the git host's name for a merge request in texts it shows, the flags of every Chromium the kit starts (chromeQuietArgs: no model, hint or update downloads; browser.mjs, report_pdf.py, Cypress Electron via adapters/build_heap.ps1) and the Local State prefs engine-playwright.mjs quietProfile seeds into kit profiles (chromeLocalState: the pref policy ComponentUpdatesEnabled sets; Chrome 157 fetches prediction models despite the flags). kit.local.json keys override it (tracker.*, process.docs).",
 "tscNoOutput": "--noEmit",
 "testRunners": [
  { "name": "cypress", "deps": ["cypress"], "files": ["cypress.config.*", "cypress.json"], "cmd": "npx cypress run --spec \"{specs}\"", "wholeSuiteRx": "\\bcypress\\s+run\\b(?![^&|;]*--spec[=\\s])",
    "specGlobs": ["**/*.cy.*", "cypress/integration/**/*.{js,ts}"], "ignore": ["**/cypress/reports/**", "**/cypress/screenshots/**", "**/cypress/videos/**"] },
  { "name": "playwright", "deps": ["@playwright/test"], "files": ["playwright.config.*"], "cmd": "npx playwright test {specs}", "wholeSuiteRx": "\\bplaywright\\s+test\\b(?![^&|;]*(\\.(spec|test)\\.\\w+|[\\w-]+/))",
    "specGlobs": ["tests/**/*.spec.*"], "ignore": ["**/test-results/**", "**/playwright-report/**"] }
 ],
 "mrWord": { "_default": "MR", "github": "PR", "gitea": "PR", "bitbucket": "PR", "azure": "PR" },
 "chromeQuietArgs": ["--no-first-run", "--disable-component-update", "--disable-background-networking", "--safebrowsing-disable-auto-update",
  "--disable-features=OptimizationGuideModelDownloading,OptimizationHintsFetching,OptimizationTargetPrediction,OptimizationGuideOnDeviceModel"],
 "chromeLocalState": { "component_updates": { "component_updates_enabled": false } },
 "envChangeCommands": ["\\baws(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?elasticbeanstalk[ \\t]+(?:update-environment|restart-app-server|rebuild-environment|swap-environment-cnames|terminate-environment)", "\\baws(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?ecs[ \\t]+(?:update-service|delete-service|stop-task)", "\\baws(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?lambda[ \\t]+(?:update-function-configuration|update-function-code|put-function-concurrency|delete-function)", "\\baws(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?ssm[ \\t]+(?:put-parameter|delete-parameters?)", "\\baws(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?(?:apprunner[ \\t]+update-service|cloudformation[ \\t]+(?:update-stack|delete-stack|deploy))", "\\bgcloud(?:\\.cmd|\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?(?:run[ \\t]+(?:deploy|services[ \\t]+update)|app[ \\t]+deploy)", "\\baz(?:\\.cmd|\\.exe)?[ \\t]+(?:webapp|functionapp)[ \\t]+(?:config[ \\t]+appsettings[ \\t]+(?:set|delete)|restart|stop)", "\\bkubectl(?:\\.exe)?[ \\t]+(?:[^\\s;&|]+[ \\t]+)*?(?:set[ \\t]+env|rollout[ \\t]+restart|scale|patch|edit)\\b", "\\bheroku(?:\\.cmd|\\.exe)?[ \\t]+(?:config:(?:set|unset)|ps:restart|restart)", "\\beb(?:\\.exe)?[ \\t]+(?:setenv|restart)\\b"],
 "statuses": {"open": ["open", "to do"], "inProgress": ["in progress"], "review": ["for review", "in review"], "failedReview": ["failed review", "changes requested", "review failed"], "promoted": ["promoted"], "inTest": ["in test", "for test"], "failedTesting": ["failed testing", "test failed"], "closed": ["closed", "complete", "done"]},
 "statusOther": ["blocked", "on hold", "paused", "for future", "backlog", "canceled", "cancelled", "won't do"],
 "trackers": {"clickup": {"branchTag": "CU-", "urlFragment": "clickup.com"}, "github": {"listless": true, "branchTag": "GH-", "urlFragment": "/issues/"}, "gitlab": {"listless": true, "branchTag": "GL-", "urlFragment": "/issues/"}, "jira": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/browse/"}, "jira-server": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/browse/"}, "linear": {"idPattern": "[A-Z][A-Z0-9]+-\\d+", "urlFragment": "linear.app"}, "youtrack": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/issue/"}, "azure": {"branchRx": "(?i)(?:\\bAB#|(?:^|/)(?=\\d+[-_]))(?<id>\\d+)", "urlFragment": "_workitems"}},
 "docs": [
  {"key": "testing-doc", "label": "Testing doc (human)", "mrLabel": "Testing doc", "linkRx": "testing doc(?! \\(ai\\))[^:\\n]{0,12}", "headerRx": "(?im)^\\|\\s*#\\s*\\|\\s*(UI steps\\s*\\|\\s*Expected on screen\\s*\\|\\s*Screenshot\\s*\\|\\s*Extra evidence\\s*\\|\\s*Result|Steps\\s*\\|\\s*Expected\\s*\\|\\s*Result\\s*\\|\\s*Evidence)\\s*\\|", "required": true},
  {"key": "testing-ai", "label": "Testing doc (AI)", "linkRx": "testing doc \\(ai\\)[ \\t*_]*", "headerRx": "(?im)^\\|\\s*#\\s*\\|\\s*Type\\s*\\|\\s*Steps\\s*/\\s*API call[^|]*\\|\\s*Expected\\s*\\|\\s*Result\\s*\\|\\s*Evidence\\s*\\|", "required": true},
  {"key": "spec", "label": "Spec", "linkRx": "spec(?! s-ids)", "required": false, "urlOnly": true}
 ]
}
