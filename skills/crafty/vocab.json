{
 "_readme": "Built-in vocabulary lib.ps1 and devtools.py both read (one source): logical statuses, tracker vendor ids and links, the default testing docs, words a .ps1 must not hold (pwsh would log the script: tscNoOutput), deployed-env change commands (guard, testing-doc prose: envChangeCommands). kit.local.json keys override it (tracker.*, process.docs).",
 "tscNoOutput": "--noEmit",
 "envChangeCommands": ["aws\\s+(?:\\S+\\s+)*?elasticbeanstalk\\s+(?:update-environment|restart-app-server|rebuild-environment|swap-environment-cnames|terminate-environment)", "aws\\s+(?:\\S+\\s+)*?ecs\\s+(?:update-service|delete-service|stop-task)", "aws\\s+(?:\\S+\\s+)*?lambda\\s+(?:update-function-configuration|update-function-code|put-function-concurrency|delete-function)", "aws\\s+(?:\\S+\\s+)*?ssm\\s+(?:put-parameter|delete-parameters?)", "aws\\s+(?:\\S+\\s+)*?(?:apprunner\\s+update-service|cloudformation\\s+(?:update-stack|delete-stack|deploy))", "gcloud\\s+(?:\\S+\\s+)*?(?:run\\s+(?:deploy|services\\s+update)|app\\s+deploy)", "az\\s+(?:webapp|functionapp)\\s+(?:config\\s+appsettings\\s+(?:set|delete)|restart|stop)", "kubectl\\s+(?:\\S+\\s+)*?(?:set\\s+env|rollout\\s+restart|scale|patch|edit)", "heroku\\s+(?:config:(?:set|unset)|ps:restart|restart)", "eb\\s+(?:setenv|restart)"],
 "statuses": {"open": ["open", "to do"], "inProgress": ["in progress"], "review": ["for review", "in review"], "promoted": ["promoted"], "inTest": ["in test", "for test"], "failedTesting": ["failed testing", "test failed"], "closed": ["closed", "complete", "done"]},
 "trackers": {"clickup": {"branchTag": "CU-", "urlFragment": "clickup.com"}, "github": {"listless": true, "branchTag": "GH-", "urlFragment": "/issues/"}, "gitlab": {"listless": true, "branchTag": "GL-", "urlFragment": "/issues/"}, "jira": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/browse/"}, "jira-server": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/browse/"}, "linear": {"idPattern": "[A-Z][A-Z0-9]+-\\d+", "urlFragment": "linear.app"}, "youtrack": {"idPattern": "[A-Z][A-Z0-9_]+-\\d+", "urlFragment": "/issue/"}, "azure": {"branchRx": "(?i)(?:\\bAB#|(?:^|/)(?=\\d+[-_]))(?<id>\\d+)", "urlFragment": "_workitems"}},
 "docs": [
  {"key": "testing-doc", "label": "Testing doc (human)", "mrLabel": "Testing doc", "linkRx": "testing doc(?! \\(ai\\))[^:\\n]{0,12}", "headerRx": "(?im)^\\|\\s*#\\s*\\|\\s*Steps\\s*\\|\\s*Expected\\s*\\|\\s*Result\\s*\\|\\s*Evidence\\s*\\|", "required": true},
  {"key": "testing-ai", "label": "Testing doc (AI)", "linkRx": "testing doc \\(ai\\)[ \\t*_]*", "headerRx": "(?im)^\\|\\s*#\\s*\\|\\s*Type\\s*\\|\\s*Steps\\s*/\\s*API call[^|]*\\|\\s*Expected\\s*\\|\\s*Result\\s*\\|\\s*Evidence\\s*\\|", "required": true}
 ]
}
